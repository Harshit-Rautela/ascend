generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model WeightEntry {
  id        String   @id @default(cuid())
  weightKg  Float
  entryDate DateTime @db.Date
  createdAt DateTime @default(now())
  notes     String?

  @@index([entryDate])
}

model NutritionEntry {
  id              String           @id @default(cuid())
  foodName        String
  mealType        String
  calories        Float
  protein         Float
  carbs           Float
  fat             Float
  entryDate       DateTime         @db.Date
  createdAt       DateTime         @default(now())
  nutrientIntakes NutrientIntake[]

  @@index([entryDate])
  @@index([mealType, entryDate])
}

model Nutrient {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  unit        String
  category    String
  createdAt   DateTime         @default(now())
  dailyTarget Float?
  intakes     NutrientIntake[]
}

model NutrientIntake {
  id               String          @id @default(cuid())
  nutrientId       String
  amount           Float
  source           String
  sourceName       String?
  nutritionEntryId String?
  entryDate        DateTime        @db.Date
  createdAt        DateTime        @default(now())
  nutrient         Nutrient        @relation(fields: [nutrientId], references: [id])
  nutritionEntry   NutritionEntry? @relation(fields: [nutritionEntryId], references: [id], onDelete: Cascade)

  @@index([entryDate])
  @@index([nutrientId, entryDate])
  @@index([source, entryDate])
  @@index([nutritionEntryId])
}

model Exercise {
  id               String            @id @default(cuid())
  name             String            @unique
  category         String
  equipment        String?
  measurementType  String
  description      String?
  isCustom         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  exerciseType     String?
  imageUrl         String?
  movementPattern  String?
  primaryMuscle    String?
  secondaryMuscles String[]          @default([])
  videoUrl         String?
  imagePublicId    String?
  videoPublicId    String?
  planExercises    PlanExercise[]
  workoutExercises WorkoutExercise[]

  @@index([category])
  @@index([primaryMuscle])
  @@index([exerciseType])
  @@index([movementPattern])
}

model TrainingPlan {
  id        String    @id @default(cuid())
  name      String    @default("My Weekly Plan")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  days      PlanDay[]
}

model PlanDay {
  id             String         @id @default(cuid())
  trainingPlanId String
  dayOfWeek      Int
  isRestDay      Boolean        @default(false)
  targetMuscles  String[]       @default([])
  notes          String?
  trainingPlan   TrainingPlan   @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercises      PlanExercise[]

  @@unique([trainingPlanId, dayOfWeek])
  @@index([trainingPlanId])
}

model PlanExercise {
  id                    String   @id @default(cuid())
  planDayId             String
  exerciseId            String
  sortOrder             Int      @default(0)
  targetSets            Int?
  targetReps            Int?
  targetWeightKg        Float?
  targetDurationSeconds Int?
  targetDistanceMeters  Float?
  notes                 String?
  exercise              Exercise @relation(fields: [exerciseId], references: [id])
  planDay               PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)

  @@unique([planDayId, sortOrder])
  @@index([exerciseId])
}

model WorkoutSession {
  id              String            @id @default(cuid())
  performedAt     DateTime          @default(now())
  durationMinutes Int?
  notes           String?
  status          String            @default("COMPLETED")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  exercises       WorkoutExercise[]

  @@index([performedAt])
  @@index([status, performedAt])
}

model WorkoutExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  exerciseId       String
  sortOrder        Int            @default(0)
  notes            String?
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  sets             WorkoutSet[]

  @@unique([workoutSessionId, sortOrder])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  weightKg          Float?
  reps              Int?
  durationSeconds   Int?
  distanceMeters    Float?
  isCompleted       Boolean         @default(false)
  notes             String?
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
}

model BodyMeasurement {
  id          String   @id @default(cuid())
  measurement String
  value       Float
  unit        String
  measuredAt  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  @@index([measurement, measuredAt])
}

model Habit {
  id          String            @id @default(cuid())
  title       String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completions HabitCompletion[]

  @@index([isActive])
}

model HabitCompletion {
  id             String   @id @default(cuid())
  habitId        String
  completionDate DateTime @db.Date
  createdAt      DateTime @default(now())
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, completionDate])
  @@index([completionDate])
}

model WaterIntake {
  id        String   @id @default(cuid())
  amountMl  Int
  entryDate DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([entryDate])
  @@map("water_intakes")
}

model StepEntry {
  id        String   @id @default(cuid())
  steps     Int
  entryDate DateTime @unique @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryDate])
}


model SleepEntry {
  id                String   @id @default(cuid())
  sleepDate         DateTime @unique @db.Date

  bedtime           String
  wakeTime          String

  timeInBedMinutes Int 
  durationMinutes   Int?

  quality           Int
  sleepScore        Float?

  awakeMinutes      Int?
  lightSleepMinutes Int?
  deepSleepMinutes  Int?

  heartRate         Int?
  hrv               Int?
  energy            Int?

  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sleepDate])
}